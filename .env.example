# Database
DATABASE_URL=postgresql://securhealth:securhealth@localhost:5433/securhealth

# Auth
JWT_SECRET=change-this-to-a-long-random-secret

# Email OTP MFA
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@securehealth.local
SMTP_SECURE=

# ML service
ML_SERVICE_URL=http://localhost:8001
AUTH_RISK_BLOCK_THRESHOLD=0.98
AUTH_RISK_MIN_FAILED_COUNT=4

# Storage
# Use fs for local development/demo mode.
# Switch to s3 in production-style deployments.
STORAGE_DRIVER=s3

# Optional S3 settings when STORAGE_DRIVER=s3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_SSL_ENABLED=true
S3_SERVER_SIDE_ENCRYPTION=

# Demo users
SEED_DEFAULT_USERS=true
DEFAULT_ADMIN_EMAIL=admin@securehealth.local
DEFAULT_ADMIN_PASSWORD=Admin123!
DEFAULT_CLINICIAN_EMAIL=clinician@securehealth.local
DEFAULT_CLINICIAN_PASSWORD=Clinician123!

# Frontend
NEXT_PUBLIC_API_URL=/api
